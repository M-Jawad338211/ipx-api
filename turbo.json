{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "openapi": {
      "cache": false
    },
    "test": {
      "dependsOn": ["openapi"],
      "cache": false,
      "passThroughEnv": ["DATA_DIR", "RUN_LIVE_TESTS"]
    }
  }
}
