# Copy to .env and fill in. Never commit .env.

# --- Data sources --------------------------------------------------------------------------
# IPinfo Lite download token (free account at ipinfo.io); without it update-db keeps the existing file.
IPINFO_TOKEN=
# MaxMind license key (optional, only needed if GeoLite2/GeoIP2 is added later).
MAXMIND_LICENSE_KEY=
# AbuseIPDB API key (optional, for future threat scoring).
ABUSEIPDB_KEY=

# --- API server ----------------------------------------------------------------------------
# Interface and port the API listens on.
HOST=0.0.0.0
PORT=8080
# Directory with the mmdb files and security lists (default: <repo>/data).
DATA_DIR=
# "cloudflare" trusts CF-Connecting-IP / X-Forwarded-For (only when the API is reachable solely via Cloudflare Tunnel); "none" uses the socket address.
TRUSTED_PROXY=none
# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# One log line per request; off by default because request logs contain client IP addresses.
LOG_REQUESTS=false
# Seconds between checks of DATA_DIR for changed files (hot reload); 0 disables the timer.
DATA_REFRESH_SECONDS=60
# Load all timezone polygons at startup (about 1.2 GB RSS) instead of lazily (about 60 MB).
TZ_PRELOAD=false
# Public base URL written into the OpenAPI document (used by the docs playground).
PUBLIC_API_URL=http://localhost:8080
# Anonymous limits per client IP (IPv6: per /64).
ANON_LIMIT_PER_MINUTE=45
ANON_LIMIT_PER_DAY=1000
# Seconds an API-key lookup is cached in memory (revocations and plan changes take up to this long).
KEY_CACHE_SECONDS=60
# Seconds between usage flushes from Redis to Postgres.
USAGE_FLUSH_SECONDS=60

# --- Databases (Phase 2) -------------------------------------------------------------------
# Postgres connection string; docker compose publishes its Postgres on host port 5433.
DATABASE_URL=postgres://ipx:ipx@localhost:5433/ipx
# Redis connection string for rate limits and usage counters.
REDIS_URL=redis://localhost:6379
# Host ports used by docker compose (change if they clash with local services).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# --- Website (apps/web) ---------------------------------------------------------------------
# API base URL the browser calls (landing-page demo, docs examples). Read at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Address behind the dashboard's "Contact us" link.
CONTACT_EMAIL=

# --- Email (Phase 2) -----------------------------------------------------------------------
# Resend API key. When set, new accounts must confirm their email with a 6-digit code before
# API keys work; when empty, accounts work right after sign-up.
RESEND_API_KEY=
# Sender of the confirmation emails (a verified Resend domain); default is Resend's test sender.
EMAIL_FROM=ipx <noreply@example.com>

# --- Billing (Phase 2) ---------------------------------------------------------------------
# "true" turns on Paddle checkout and the webhook; otherwise the dashboard shows "Contact us".
PAYMENTS_ENABLED=false
# Paddle API key (server side, for future subscription management calls).
PADDLE_API_KEY=
# Paddle webhook signing secret (Paddle-Signature header).
PADDLE_WEBHOOK_SECRET=
# Paddle client-side token for Paddle.js checkout.
PADDLE_CLIENT_TOKEN=
# "sandbox" or "production".
PADDLE_ENVIRONMENT=sandbox
# Paddle price ids for the paid plans.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=

# --- Operations (Phase 3) ------------------------------------------------------------------
# Webhook (Slack/Discord compatible) that receives update failures and stale-data alerts.
ALERT_WEBHOOK_URL=
